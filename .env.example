# Read by docker compose (compose.yaml) to configure MySQL and the API.
MYSQL_DATABASE=ecom_admin
MYSQL_USER=storefront
MYSQL_PASSWORD=change-me
API_PORT=8000

# Read by the app when you run uvicorn on the host against your own MySQL.
DATABASE_URL=mysql+aiomysql://storefront:change-me@127.0.0.1:3306/ecom_admin
CREATE_SCHEMA=false
